# Bento (RAG) — configuração local. Copie para .env (ignorado pelo git) e ajuste.
# Tudo roda via Docker Compose no WSL2; o único serviço fora dos containers é o Ollama do Windows 11.

# ----- Servidor -----
PORT=3000
# Endereço do WSL2 em que a porta é publicada. 127.0.0.1 = só este PC (o Windows alcança via localhost).
APP_BIND=127.0.0.1

# ----- Login -----
MASTER_USER=admin
# TROQUE esta senha antes de expor o app.
MASTER_PASSWORD=admin123
# Gere com: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
#COOKIE_SECURE=false
#TRUST_PROXY=false

# ----- Volumes persistentes (Qdrant, SQLite, uploads/OCR/voz) -----
# Padrão: ./volumes na pasta do projeto. Qdrant e SQLite exigem disco local do Linux (ext4 do WSL):
# se o projeto estiver em /mnt/c (disco do Windows), aponte para uma pasta do WSL, ex.: /home/<usuario>/rag-volumes.
#VOLUMES_DIR=./volumes
# Dono dos arquivos nos volumes (o usuário padrão do WSL costuma ser 1000:1000).
APP_UID=1000
APP_GID=1000

# ----- Qdrant (busca vetorial; só na rede interna do Compose, sem porta publicada) -----
# Gere com: openssl rand -hex 32
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
# Quantização INT8: quantil de calibração, sobreamostragem do rescore com os vetores originais e ef do HNSW na busca.
#QDRANT_QUANTILE=0.99
#QDRANT_OVERSAMPLING=2
#QDRANT_HNSW_EF=128
# Vetores originais (float32) em disco; a RAM fica com os quantizados (int8).
#QDRANT_ON_DISK_VECTORS=true
# Quantização dos vetores densos usados na busca (originais ficam no disco para o rescore). int8 (padrão, ~1 KB por trecho
# com bge-m3) · binary2 (2 bits, ~256 B, 4x menos RAM) · binary (1 bit, ~128 B, 8x menos RAM). Vale para a collection
# existente (o Qdrant reconstrói em segundo plano, sem reindexar). Use binary2/binary só com milhões de trechos.
#QDRANT_QUANTIZATION=int8
# false = vetores quantizados também no disco (mmap): menos RAM, buscas mais lentas.
#QDRANT_QUANTIZED_IN_RAM=true
# Índice invertido do BM25 no disco (mmap): a RAM não cresce com o vocabulário. false = na RAM.
#QDRANT_SPARSE_ON_DISK=true

# ----- Ollama do Windows 11 -----
# IP do Windows visto pelo WSL2 (no WSL: ip route show default | awk '{print $3}').
# O Ollama continua escutando só em 127.0.0.1; a ponte para o WSL2 é criada por scripts/windows/ollama-wsl-bridge.ps1.
OLLAMA_BASE_URL=http://172.29.48.1:11434
#OLLAMA_API_KEY=
# Modelo de linguagem (respostas) e modelo de embeddings (busca): independentes. Trocar o de embeddings exige "Reindexar".
OLLAMA_LLM_MODEL=qwen3:1.7b
OLLAMA_EMBEDDING_MODEL=bge-m3
# Threads do Ollama: medidas na 1ª inicialização (APP_DATA_DIR/tuning.json). AUTOTUNE=false desliga.
#OLLAMA_NUM_THREAD=6
#AUTOTUNE=true

# ----- Ingestão e chunking -----
MAX_FILE_SIZE_MB=100
# Pasta do host com arquivos para importar em lote (botão "Pasta" no notebook; cada subpasta pode ir para um notebook).
# Os arquivos são lidos onde estão (montagem só leitura), sem cópia; repetidos (mesmo conteúdo) são ignorados.
#IMPORT_DIR=./import
OCR_LANG=por+eng
DOCUMENT_PROCESS_CONCURRENCY=1
CHUNK_SIZE=700
CHUNK_OVERLAP=100
# Trechos por requisição de embedding (e por lote enviado ao Qdrant).
#EMBED_BATCH_SIZE=8
# BM25: tamanho médio de referência de um trecho (em termos) para normalizar a frequência.
#BM25_AVG_DOC_LEN=80
# Reconciliação periódica SQLite ↔ Qdrant (só roda se houver indexação falha ou exclusão pendente).
#SYNC_INTERVAL_MIN=5

# ----- Busca -----
# TOP_K, vizinhos, contexto e tokens são decididos pelo perfil do modelo. Descomente só para sobrescrever.
#RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.48
#NEIGHBOR_EXPAND_TOP=1

# ----- Reranking local (filtro de precisão) -----
# Cross-Encoder ONNX em CPU reordena os candidatos da busca híbrida pela relevância real com a pergunta; só os melhores vão ao prompt.
# Modelo baixado do Hugging Face no 1º uso para APP_DATA_DIR/reranker (~135 MB). Até ficar pronto, a busca segue sem reranking.
#RERANK_ENABLED=true
# Padrão multilíngue (mMARCO, inclui português), ~1 s para 25 trechos em CPU (+~380 MB de RAM). Mais pesado (~11 s): onnx-community/bge-reranker-v2-m3-ONNX
#RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Arquivo em onnx/ sem ".onnx" (vazio = model_quint8_avx2 no padrão, model_int8 nos demais).
#RERANK_MODEL_FILE=
#RERANK_CANDIDATES=25
# Quantos trechos seguem ao prompt não é fixo: todos os que ficam a até RERANK_MAX_GAP (logit do Cross-Encoder) da nota do melhor,
# do mais relevante ao menos relevante, até caberem no contexto do modelo. O melhor e os com o código exato da pergunta sempre seguem.
#RERANK_MAX_GAP=6
# Teto opcional de trechos (vazio = sem teto; 4 nos modelos < 1B).
#RERANK_TOP_N=
# Ordem dos trechos no prompt: relevance_first (padrão, o mais relevante primeiro) ou relevance_last (o mais relevante por último,
# junto da pergunta; com qwen3.5:2b acertou 14/14 contra 12/14 nas perguntas de histórico/versão do benchmark).
#CONTEXT_ORDER=relevance_first
# Modo conversa (chat com "Conversa" ligado e modo de voz): cumprimentos, agradecimentos e conversa respondem sem buscar nos documentos.
# Com a melhor nota do reranking abaixo de CONVERSATION_JUDGE_BELOW, a IA decide se a mensagem pede algo dos documentos (~1 s).
#CONVERSATION_ROUTING=true
#CONVERSATION_JUDGE_BELOW=0
#RERANK_MAX_LENGTH=512
# Trechos por lote do ONNX (lotes pequenos: mais rápido e menos memória).
#RERANK_BATCH=4
# Threads do ONNX (vazio = todos os núcleos).
#RERANK_THREADS=
#RERANK_HF_URL=https://huggingface.co

# ----- Resposta do modelo -----
#CHAT_MAX_TOKENS=1024
#MAX_CONTEXT_CHARS=5000

# ----- Memória da conversa -----
HISTORY_MESSAGES=4
HISTORY_MAX_CHARS=2000
MAX_MESSAGES_PER_CONVERSATION=40

# ----- Modo de voz (transcrição e voz locais, sherpa-onnx) -----
# Modelos baixados do Hugging Face no 1º uso para APP_DATA_DIR/voice (~740 MB com o Parakeet).
#VOICE_ENABLED=true
#VOICE_STT_MODEL=parakeet
#VOICE_STT_LANGUAGE=pt
#VOICE_NUM_THREADS=4
#VOICE_HF_URL=https://huggingface.co

# ----- Apresentação pública -----
PRESENT_ASK_PER_MIN=20
