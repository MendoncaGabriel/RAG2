# RAG Local — configuração (local; este arquivo é ignorado pelo git)

# ----- Servidor -----
PORT=3000

# ----- Login -----
MASTER_USER=admin
# TROQUE esta senha antes de expor o app.
MASTER_PASSWORD=admin123
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=867b03547fc41b07049ed21a0ec10b116c391d260a2725c2ddaa0173d1012319ea6d83a2cfc3d08837f654f28f30617d
JWT_EXPIRES_IN=8h

# ----- Armazenamento -----
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=100
OCR_LANG=por+eng
DOCUMENT_PROCESS_CONCURRENCY=1

# ----- Chunking -----
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ----- Busca (modo leve) -----
RETRIEVAL_TOP_K=3
MIN_RELEVANCE_SCORE=0.48
NEIGHBOR_EXPAND_TOP=0
QUERY_EXPANSION=false
# Verificação de escopo: uma chamada curta ao modelo confere se o contexto trata do assunto exato da pergunta (recusa o que não está nos documentos)
SCOPE_CHECK=true

# ----- Resposta do modelo (modo leve) -----
# Base de tokens: o botão "Rápido" usa 50% disso e o "Detalhado" 200%.
CHAT_MAX_TOKENS=400
MAX_CONTEXT_CHARS=3500
# Threads do Ollama: 6 deu o melhor equilíbrio no i5-1235U (2 núcleos de performance + núcleos de economia).
OLLAMA_NUM_THREAD=6

# ----- Memória da conversa -----
HISTORY_MESSAGES=1
HISTORY_MAX_CHARS=2000
MAX_MESSAGES_PER_CONVERSATION=40

# ----- Apresentação pública -----
PRESENT_ASK_PER_MIN=20

# ----- Desempenho em CPU -----
# Resumo automático da conversa = geração extra em segundo plano; desligado para poupar CPU.
CONVERSATION_SUMMARY=false
