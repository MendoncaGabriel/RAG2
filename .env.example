# =============================================================================
# RAG Local — configuração
# Copie este arquivo para ".env" e ajuste. Linhas começando com "#" são
# comentários; para ativar uma opção comentada, remova o "#" do início.
# Reinicie o servidor depois de alterar qualquer valor.
#
# A IA (provedor, chave de API, URL base e modelos) NÃO é configurada aqui:
# use a tela de Configurações do app.
# =============================================================================

# ----- Servidor --------------------------------------------------------------
# Porta onde o app fica disponível (http://localhost:PORT).
PORT=3000

# ----- Login (obrigatório) ---------------------------------------------------
# Usuário e senha de acesso ao app. A senha é convertida em hash bcrypt ao iniciar.
MASTER_USER=admin
MASTER_PASSWORD=troque-esta-senha
# Segredo usado para assinar a sessão (JWT). Mínimo de 32 caracteres e secreto.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Por quanto tempo o login vale antes de pedir senha de novo (ex.: 8h, 24h, 7d).
JWT_EXPIRES_IN=8h

# ----- HTTPS / proxy reverso (só em produção) --------------------------------
# COOKIE_SECURE=true  -> o cookie de sessão só trafega por HTTPS. Use com HTTPS.
# TRUST_PROXY=true    -> confia no proxy à frente do app (nginx, Cloudflare etc.)
#                        para descobrir o IP real do visitante.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# ----- Arquivos e armazenamento ----------------------------------------------
# Onde ficam o banco SQLite e os arquivos enviados. No Docker isso já fica em
# ./data por meio de um volume; estas linhas só importam fora do Docker.
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads
# Tamanho máximo de cada arquivo enviado, em MB (padrão 100).
# MAX_FILE_SIZE_MB=100
# Idiomas do OCR de imagens e PDFs escaneados (códigos Tesseract unidos por "+").
OCR_LANG=por+eng
# Pasta dos dados de idioma do OCR (padrão ./data/ocr-languages).
# OCR_DATA_DIR=./data/ocr-languages
# Quantos documentos são processados ao mesmo tempo: 1 ou 2. Use 1 em PC fraco.
DOCUMENT_PROCESS_CONCURRENCY=1

# ----- Como os documentos são divididos --------------------------------------
# Cada documento é cortado em trechos ("chunks") que viram a base de busca.
# Alterar estes valores só vale para documentos novos; use "Reindexar" nos antigos.
# Tamanho de cada trecho, em caracteres.
CHUNK_SIZE=800
# Quantos caracteres se repetem entre trechos vizinhos (evita cortar uma ideia ao meio).
CHUNK_OVERLAP=120

# ----- Busca nos documentos --------------------------------------------------
# Quantos trechos são enviados ao modelo por pergunta.
# Automático conforme o tamanho do modelo: 3 / 6 / 6 / 9. Mais trechos = mais
# completo, porém mais lento. Máximo 12.
# RETRIEVAL_TOP_K=5
# Similaridade mínima (0 a 1) para um trecho contar como relevante. Suba se
# aparecerem trechos sem relação com a pergunta; baixe se o app disser que não
# encontrou nada de coisas que existem nos documentos.
MIN_RELEVANCE_SCORE=0.18
# Quantos dos melhores trechos recebem também o trecho anterior e o seguinte,
# para dar mais contexto. 0 desliga. Automático: 1 em modelos pequenos, 2 nos demais.
# NEIGHBOR_EXPAND_TOP=2
# Reformula a pergunta com o LLM para achar mais trechos. Custa +1 geração por
# pergunta; deixe "false" em modelos pequenos ou lentos.
QUERY_EXPANSION=false

# ----- Resposta do modelo ----------------------------------------------------
# O app ajusta sozinho conforme o tamanho do modelo de chat (lido do nome, como
# 0.5b, 1.5b, 8b, 70b; modelos hospedados contam como grandes). As linhas abaixo
# só servem para FORÇAR um valor para qualquer modelo.
# Máximo de tokens gerados por resposta. Automático: 384 / 700 / 1024 / 2048.
# Menor = resposta mais curta e rápida. Mínimo efetivo: 128.
# CHAT_MAX_TOKENS=1024
# Máximo de caracteres de documentos enviados ao modelo. Automático: 3500 / 8000 / 9000 / 15000.
# Menor = mais rápido, porém com menos informação para responder.
# MAX_CONTEXT_CHARS=7500

# ----- Memória da conversa ---------------------------------------------------
# O app guarda um resumo da conversa mais as últimas mensagens, para entender
# perguntas como "explique melhor".
# Quantas mensagens recentes entram na conversa enviada ao modelo.
HISTORY_MESSAGES=4
# Limite de caracteres dessas mensagens recentes.
HISTORY_MAX_CHARS=2000
# Máximo de mensagens guardadas por conversa; ao passar, as mais antigas são apagadas.
MAX_MESSAGES_PER_CONVERSATION=40

# ----- Telas de apresentação (públicas) --------------------------------------
# Não gravam nada no banco. Limite de perguntas por minuto, por IP (padrão 20).
# PRESENT_ASK_PER_MIN=20

# ----- Docker (opcional) -----------------------------------------------------
# No Linux, para subir só com "docker compose up -d --build".
# COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml
