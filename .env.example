PORT=3000
# Login (obrigatório). A senha é convertida em hash bcrypt ao iniciar; a sessão usa JWT em cookie httpOnly.
MASTER_USER=admin
MASTER_PASSWORD=troque-esta-senha
# Segredo do JWT, mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Em produção com HTTPS / atrás de proxy reverso:
# COOKIE_SECURE=true
# TRUST_PROXY=true
# A IA (provedor, chaves de API, URL base e modelos) é configurada na tela de Configurações do app.
# Ajuste automático por modelo: o app lê o tamanho no nome do modelo de chat (0.5b, 1.5b, 8b, 70b…; modelos hospedados contam como grandes)
# e escolhe sozinho trechos recuperados, tamanho do contexto, limite de resposta e penalidade de repetição.
# Descomente as linhas abaixo apenas para FORÇAR um valor, que passa a valer para qualquer modelo.
# Máximo de tokens gerados por resposta (automático: 384 / 640 / 1024 / 2048).
# CHAT_MAX_TOKENS=1024
OCR_LANG=por+eng
# Caminhos usados só fora do Docker (no Docker ficam em ./data via volume)
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads
# Memória da conversa: resumo rolante (gerado em segundo plano) + janela das últimas N mensagens, com máximo de caracteres
HISTORY_MESSAGES=4
HISTORY_MAX_CHARS=2000
# Telas de apresentação (públicas): não gravam nada no banco; limite de perguntas por minuto por IP
# PRESENT_ASK_PER_MIN=20
# Fila de mensagens por conversa: ao passar do limite, as mais antigas são apagadas do banco
MAX_MESSAGES_PER_CONVERSATION=40
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# Trechos recuperados por pergunta (automático: 3 / 4 / 6 / 9).
# RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.18
# Máximo de caracteres de contexto enviados ao modelo (automático: 3500 / 5500 / 9000 / 15000).
# MAX_CONTEXT_CHARS=7500
# Expansão de consulta por LLM: +1 geração por pergunta. Desligada por padrão para modelos leves.
QUERY_EXPANSION=false
DOCUMENT_PROCESS_CONCURRENCY=1
# Trechos vizinhos adicionados aos N melhores resultados; 0 desliga (automático: 1 para modelos pequenos, 2 para os demais)
# NEIGHBOR_EXPAND_TOP=2

# Docker (opcional): no Linux, para rodar só "docker compose up -d --build"
# COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml
