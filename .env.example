PORT=3000
# Ollama ao rodar com `npm run dev` (fora do Docker):
OLLAMA_BASE_URL=http://localhost:11434
# Ollama ao rodar no Docker (o compose ignora OLLAMA_BASE_URL acima, pois "localhost" seria o próprio container).
# Padrão: http://host.docker.internal:11434 (Ollama instalado no host, escutando em 0.0.0.0).
# Só defina se o Ollama estiver em outro endereço, ex.: http://192.168.0.10:11434
# DOCKER_OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OCR_LANG=por+eng
# Caminhos usados só fora do Docker (no Docker ficam em ./data via volume)
DATABASE_PATH=./data/database.sqlite
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
MIN_RELEVANCE_SCORE=0.18
MAX_CONTEXT_CHARS=7500
# Expansão de consulta por LLM: +1 geração por pergunta. Desligada por padrão para modelos leves.
QUERY_EXPANSION=false
DOCUMENT_PROCESS_CONCURRENCY=1
# Trechos vizinhos adicionados aos N melhores resultados (0 desliga)
NEIGHBOR_EXPAND_TOP=2

# Docker (opcional): no Linux, para rodar só "docker compose up -d --build"
# COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml
